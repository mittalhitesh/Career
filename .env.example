# Default AI provider: mock | gemini | openai | watsonx | custom
VITE_DEFAULT_PROVIDER=mock

# Google Gemini (Native REST API)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.8-flash

# OpenAI-compatible provider (OpenAI, Groq, OpenRouter, Together, Ollama, etc.)
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_MODEL=gpt-4o-mini

# IBM Watsonx.ai provider
VITE_WATSONX_API_KEY=
VITE_WATSONX_PROJECT_ID=
VITE_WATSONX_URL=https://us-south.ml.cloud.ibm.com
VITE_WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Custom Backend proxy (recommended for production to avoid browser CORS & exposed keys)
VITE_CUSTOM_BACKEND_URL=
VITE_CUSTOM_BACKEND_HEADER_NAME=
VITE_CUSTOM_BACKEND_HEADER_VALUE=
